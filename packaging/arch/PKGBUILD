# Maintainer: Lucas <codeberg.ecx3s@passmail.com>
pkgname=frihart
pkgver=0.1.0
pkgrel=1
pkgdesc="Sovereign privacy-first web browser (LibreWolf-inspired, original code)"
arch=('x86_64' 'aarch64')
url="https://codeberg.org/ichbinlucasv/Frihart"
license=('MIT' 'Apache')
depends=('gcc-libs' 'fontconfig' 'freetype2')
makedepends=('cargo' 'git')
# ring's C/asm core breaks under makepkg CFLAGS / rust LTO.
options=('!lto' '!buildflags')
# Release: git tag. Local tree: FRIHART_LOCAL=1 makepkg -f --nocheck
if [ "${FRIHART_LOCAL:-0}" = 1 ]; then
  source=()
  sha256sums=()
else
  source=("$pkgname::git+https://codeberg.org/ichbinlucasv/Frihart.git#tag=v$pkgver")
  sha256sums=('SKIP')
fi

prepare() {
  if [ "${FRIHART_LOCAL:-0}" = 1 ]; then
    rm -rf "$srcdir/$pkgname"
    mkdir -p "$srcdir/$pkgname"
    git -C "$startdir/../.." archive HEAD | tar -x -C "$srcdir/$pkgname"
  fi
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # ring's assembly objects do not link with rust-lld on this toolchain.
  export RUSTFLAGS="${RUSTFLAGS:-} -C link-arg=-fuse-ld=bfd"
  cargo build --frozen --release --bin frihart
}

check() {
  cd "$pkgname"
  cargo test --frozen --workspace
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/frihart" "$pkgdir/usr/bin/frihart"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 packaging/linux/org.frihart.Frihart.desktop \
    "$pkgdir/usr/share/applications/org.frihart.Frihart.desktop"
  for sz in 64x64 128x128 256x256 512x512; do
    install -Dm644 "branding/hicolor/$sz/apps/frihart.png" \
      "$pkgdir/usr/share/icons/hicolor/$sz/apps/frihart.png"
  done
}
